# Copy to .env.local. Everything is optional: without NEXT_PUBLIC_API_URL the dashboard
# runs scenarios in the browser with the TypeScript engine.

# URL of the FastAPI service, e.g. http://localhost:8000
NEXT_PUBLIC_API_URL=

# Sub-path when hosting under a folder (GitHub Pages project sites), e.g. /airport-digital-twin-simulation
NEXT_PUBLIC_BASE_PATH=
