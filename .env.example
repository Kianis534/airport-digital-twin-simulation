# Copy to .env and adjust. The project needs no API keys or secrets to run.

# FastAPI service
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
MAX_JOBS=200
JOB_WORKERS=2

# Optional: alternative folders for model artifacts and pipeline outputs
# AIRPORT_TWIN_ARTIFACTS=ml_models/artifacts
# AIRPORT_TWIN_OUTPUTS=outputs
